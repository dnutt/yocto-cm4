# ─────────────────────────────────────────────────────────────────────────────
# Environment variables read by docker-compose.yml
#
# Set HOST_UID/HOST_GID to your Ubuntu user's IDs so that files written by
# the container into ./workspace, ./downloads, and ./sstate-cache are owned
# by you, not by root.
#
# Run this on the Ubuntu host to get the right values:
#   id -u && id -g
# ─────────────────────────────────────────────────────────────────────────────
HOST_UID=1000
HOST_GID=1000
