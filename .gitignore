# Yocto build artifacts — these are large and should not be committed.
# Keep the directories themselves (tracked via .gitkeep) so that docker
# compose bind mounts have existing target paths on a fresh clone.
workspace/*
!workspace/.gitkeep

downloads/*
!downloads/.gitkeep

sstate-cache/*
!sstate-cache/.gitkeep

mirror/*
!mirror/.gitkeep

# Local environment overrides
.env.local
